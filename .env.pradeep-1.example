# Local override for running docker-compose.yml's api (which serves the UI itself - see that
# file's comments) AS the pradeep-1 instance.
#
# Usage:  docker compose --env-file .env.pradeep-1 -p spreadtrader-pradeep-1 up --build
# Then open http://localhost:8090 - the dashboard, API, and SignalR hub are all on that one port.
#
# THIS IS ALSO THE TEMPLATE FOR DOKPLOY: everything below (minus the local-only API_PORT/POSTGRES_*
# lines) is exactly what to paste into pradeep-1's Dokploy Application -> Environment tab in one
# shot - see .env.production.example for the full explanation of this pattern.
#
# Copy this to `.env.pradeep-1` (gitignored) and fill in real values before use - NEVER commit the
# filled-in file, and never paste real values into a chat with an AI assistant, including this one.

ASPNETCORE_ENVIRONMENT=pradeep-1
ASPNETCORE_URLS=http://+:8080

API_PORT=8090

# ---- Broker: this instance uses Dhan, AuthMode "Consent" (see appsettings.pradeep-1.json) -------
# Browser OAuth-style login - AppId/AppSecret must be set for the dashboard's "Login to Dhan"
# button to appear; you (or whoever operates this instance) then complete that login periodically
# (tokens from this flow last 24h). A DIFFERENT Dhan account from Production/pradeep-2 - never
# reuse another instance's credentials here.
#   ClientId    - this Dhan account's numeric client id
#   AppId / AppSecret - this instance's registered Dhan partner-app credentials
# ROTATE THESE in the Dhan portal - the values currently committed in
# appsettings.pradeep-1.json are exposed in this repo's git history and should be treated as
# already compromised.
Dhan__ClientId=
Dhan__AppId=
Dhan__AppSecret=
# Leave empty unless you switch this instance's Broker:Platform/Dhan:AuthMode to "Totp" instead -
# appsettings.pradeep-1.json currently also carries a Pin/TotpSecret pair (also exposed in git
# history, also worth rotating even if unused under Consent mode) for that alternative.
Dhan__AccessToken=
Dhan__Pin=
Dhan__TotpSecret=

Dashboard__BaseUrl=http://localhost:8090

# ---- Auth / password encryption - see the WARNING in LINUX_VPS_DEPLOYMENT.md §5 -----------------
# Currently a SHARED "CHANGE_ME_dev_only..." placeholder across all three instances in git -
# generate a real, random 32+ character value here, ideally DIFFERENT from Production/pradeep-2's.
#   Jwt__Key               signs every auth token for this instance's API/dashboard login
#   Security__PasswordKey  encrypts App_Data/users.pradeep-1.csv - do NOT change this again once
#                          set and in use, see Tools/Decrypt-Users.ps1
Jwt__Key=
Security__PasswordKey=

# ---- Telegram order/PNL alerts (optional - Telegram:Enabled in appsettings.pradeep-1.json) ------
# Also currently committed in git as a real, live bot token - rotate via @BotFather if cleaning up.
Telegram__BotToken=
Telegram__ChatId=

# All three instances can point at the SAME Postgres - pradeep-1 only READS it
# (Engine:SpreadHistoryWriter=false - pradeep-2 is the writer).
Storage__SpreadHistoryConnectionString=Host=db;Port=5432;Database=spreadtrader_history;Username=spreadtrader;Password=CHANGE_ME

# App_Data persistence - THIS INSTANCE'S OWN volume, never shared with Production/pradeep-2's.
Storage__TriggersCsvPath=/data/triggers.csv
Storage__ExitTriggersCsvPath=/data/exit_triggers.csv
Storage__PnlAlertsCsvPath=/data/pnl-alerts.csv
Storage__FuturesCsvPath=/data/futures_instruments.csv
Storage__DhanScripMasterCachePath=/data/dhan_scrip_master_cache.csv
Storage__BrokerPlatformOverridePath=/data/broker-platform-override.txt
Storage__UniverseCsvPath=/data/universe_futures.csv
Storage__McxUniverseCsvPath=/data/universe_mcx.csv
Storage__UsersCsvPath=/data/users.csv

# ---- Local Postgres only (not part of the Dokploy paste) ----------------------------------------
POSTGRES_DB=spreadtrader_history
POSTGRES_USER=spreadtrader
POSTGRES_PASSWORD=
