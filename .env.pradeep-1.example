# Local override for running docker-compose.yml's api (which serves the UI itself - see that
# file's comments) AS the pradeep-1 instance.
#
# Usage:  docker compose --env-file .env.pradeep-1 -p spreadtrader-pradeep-1 up --build
# Then open http://localhost:8090 - the dashboard, API, and SignalR hub are all on that one port.
#
# See .env.production.example for the full explanation of the -p flag and why this file exists.
# Copy this to `.env.pradeep-1` (gitignored) and fill in real values before use - NEVER commit the
# filled-in file.

ASPNETCORE_ENVIRONMENT=pradeep-1

API_PORT=8090

# pradeep-1's own broker credentials (Broker:Platform is "Dhan" for this instance - see
# appsettings.pradeep-1.json - so these are actually Dhan__ApiKey/Dhan__ApiSecret; add Dhan__* env
# vars to docker-compose.yml's api service the same way KITE_* is wired up if you need to run this
# instance's real broker locally). A DIFFERENT account from Production and pradeep-2 - never reuse
# another instance's key here.
KITE_API_KEY=
KITE_API_SECRET=
# Never set a standing access token here - obtained daily via the dashboard's "Login to Kite".
KITE_ACCESS_TOKEN=

DASHBOARD_BASE_URL=http://localhost:8090

# Shared local Postgres - pradeep-1 only READS this database (Engine:SpreadHistoryWriter=false).
POSTGRES_DB=spreadtrader_history
POSTGRES_USER=spreadtrader
POSTGRES_PASSWORD=
