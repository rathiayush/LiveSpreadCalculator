# Local override for running docker-compose.yml's api (which serves the UI itself - see that
# file's comments) AS the Production instance.
#
# Usage:  docker compose --env-file .env.production -p spreadtrader-production up --build
# Then open http://localhost:8080 - the dashboard, API, and SignalR hub are all on that one port.
#
# `-p spreadtrader-production` gives this stack its own Compose project name, so it doesn't share
# container/volume names with a pradeep-1 or pradeep-2 stack you might also be running locally from
# the SAME docker-compose.yml (see .env.pradeep-1.example / .env.pradeep-2.example).
#
# THIS IS ALSO THE TEMPLATE FOR DOKPLOY: everything below (minus the local-only API_PORT/POSTGRES_*
# lines) is exactly what to paste into Production's Dokploy Application -> Environment tab in one
# shot, instead of typing each field in individually - Dokploy's environment editor accepts a raw
# KEY=VALUE block, not just one field at a time. See LINUX_VPS_DEPLOYMENT.md §3/§5.
#
# Copy this to `.env.production` (gitignored) and fill in real values before use - NEVER commit the
# filled-in file, and never paste real values into a chat with an AI assistant, including this one.

ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# Host port for LOCAL COMPOSE ONLY - not read by Dokploy (Dokploy assigns the public port itself
# via its Domains tab, always pointed at container port 8080). Distinct from pradeep-1/pradeep-2's
# so all three could run side by side locally if you ever wanted to.
API_PORT=8080

# ---- Broker: this instance uses Dhan, AuthMode "Totp" (see appsettings.Production.json) --------
# Fully automatic once these three are set - no daily manual step, no browser login. A DIFFERENT
# Dhan account from pradeep-1/pradeep-2 - never reuse another instance's credentials here.
#   ClientId    - this Dhan account's numeric client id
#   Pin         - this Dhan account's login PIN
#   TotpSecret  - the base32 TOTP seed from Dhan Web -> Profile -> DhanHQ Trading APIs -> Setup TOTP
# TREAT Pin/TotpSecret AS LOGIN CREDENTIALS, NOT TOKENS - unlike a leaked access token (expires
# within 24h regardless), these two together let anyone mint a fresh valid token indefinitely.
# ROTATE THESE in the Dhan portal - the values currently committed in appsettings.Production.json
# are exposed in this repo's git history and should be treated as already compromised.
Dhan__ClientId=
Dhan__Pin=
Dhan__TotpSecret=
# Leave these empty - Totp mode doesn't use them (AccessToken is obtained automatically in memory;
# AppId/AppSecret are only for the separate Consent/OAuth flow, unused here).
Dhan__AccessToken=
Dhan__AppId=
Dhan__AppSecret=

Dashboard__BaseUrl=http://localhost:8080

# ---- Auth / password encryption - see the WARNING in LINUX_VPS_DEPLOYMENT.md §5 -----------------
# Both currently sit in git as a SHARED "CHANGE_ME_dev_only..." placeholder across all three
# instances (appsettings.*.json) - generate real, random 32+ character values here instead, and
# ideally a DIFFERENT one per instance so a leak of one doesn't affect the others.
#   Jwt__Key           signs every auth token for this instance's API/dashboard login
#   Security__PasswordKey  encrypts App_Data/users.csv - do NOT change this again once set and in
#                          use, or every already-encrypted password becomes unreadable (see
#                          PasswordProtector's doc comment / Tools/Decrypt-Users.ps1)
Jwt__Key=
Security__PasswordKey=

# ---- Telegram order/PNL alerts (optional - Telegram:Enabled in appsettings.Production.json) -----
# Also currently committed in git as a real, live bot token - rotate via @BotFather if you're
# treating this migration as the point to clean these up. Leave both blank and the app just sends
# no Telegram notifications (Enabled still true in appsettings, but CompositeOrderExecutionSink /
# TelegramNotifier no-op without a token).
Telegram__BotToken=
Telegram__ChatId=

# Overrides the placeholder in appsettings.json with the real db service below. "db" only
# resolves on this compose network - see EfSpreadHistoryStore / SpreadHistoryDbContext. Production
# only READS this database (Engine:SpreadHistoryWriter=false - pradeep-2 is the writer).
Storage__SpreadHistoryConnectionString=Host=db;Port=5432;Database=spreadtrader_history;Username=spreadtrader;Password=CHANGE_ME

# App_Data persistence - see LINUX_VPS_DEPLOYMENT.md §6. Locally these just land in the container's
# own filesystem (fine for a throwaway local run); in Dokploy, /data MUST be a mounted Volume on
# THIS instance's Application, not shared with pradeep-1/pradeep-2's.
Storage__TriggersCsvPath=/data/triggers.csv
Storage__ExitTriggersCsvPath=/data/exit_triggers.csv
Storage__PnlAlertsCsvPath=/data/pnl-alerts.csv
Storage__FuturesCsvPath=/data/futures_instruments.csv
Storage__DhanScripMasterCachePath=/data/dhan_scrip_master_cache.csv
Storage__BrokerPlatformOverridePath=/data/broker-platform-override.txt
Storage__UniverseCsvPath=/data/universe_futures.csv
Storage__McxUniverseCsvPath=/data/universe_mcx.csv
Storage__UsersCsvPath=/data/users.csv

# ---- Local Postgres only (not part of the Dokploy paste - Dokploy's Postgres is a separate
# resource, see LINUX_VPS_DEPLOYMENT.md §4) ---------------------------------------------------
POSTGRES_DB=spreadtrader_history
POSTGRES_USER=spreadtrader
POSTGRES_PASSWORD=
