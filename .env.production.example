# Local override for running docker-compose.yml's api (which serves the UI itself - see that
# file's comments) AS the Production instance.
#
# Usage:  docker compose --env-file .env.production -p spreadtrader-production up --build
# Then open http://localhost:8080 - the dashboard, API, and SignalR hub are all on that one port.
#
# `-p spreadtrader-production` gives this stack its own Compose project name, so it doesn't share
# container/volume names with a pradeep-1 or pradeep-2 stack you might also be running locally from
# the SAME docker-compose.yml (see .env.pradeep-1.example / .env.pradeep-2.example) - each is a
# fully separate set of containers, distinguished by project name and the API_PORT below.
#
# Copy this to `.env.production` (gitignored) and fill in real values before use - NEVER commit the
# filled-in file. Mirrors exactly what that instance's `api` Dokploy Application needs in
# production - see LINUX_VPS_DEPLOYMENT.md §3/§5b - so this doubles as a local way to reproduce
# that instance's behavior before/without touching the live deployment.

ASPNETCORE_ENVIRONMENT=Production

# Host port for this stack - distinct from pradeep-1/pradeep-2's so all three could run side by
# side locally if you ever wanted to. Not required to differ if you only ever run one at a time.
API_PORT=8080

# Production's own broker credentials (Broker:Platform is "Dhan" for this instance - see
# appsettings.Production.json - so these are actually Dhan__ApiKey/Dhan__ApiSecret; the Kite__*
# names below are shown as the example since docker-compose.yml's api service currently only wires
# up Kite__* env vars - add Dhan__* the same way if you need to run this instance's real broker
# locally). Real values only - never the placeholder/compromised ones already sitting in
# appsettings.Production.json (see DEPLOYMENT.md §0, rotate before using anywhere).
KITE_API_KEY=
KITE_API_SECRET=
# Never set a standing access token here - it's obtained daily via the dashboard's "Login to Kite"
# button, not a config value with a long lifetime.
KITE_ACCESS_TOKEN=

DASHBOARD_BASE_URL=http://localhost:8080

# Shared local Postgres (the `db` service) - same for all three .env.*.example files, since
# Production only READS this database (Engine:SpreadHistoryWriter=false - pradeep-2 is the writer).
POSTGRES_DB=spreadtrader_history
POSTGRES_USER=spreadtrader
POSTGRES_PASSWORD=
