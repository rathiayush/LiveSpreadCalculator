{
  // Local development overlay - selected by ASPNETCORE_ENVIRONMENT=Local (see the "Local (SQL)"
  // launch profile in Properties/launchSettings.json). Overrides the base appsettings.json - which
  // points spread history at the shared Azure SQL - so LOCAL runs use a local SQL Server / LocalDB
  // instead, with no Azure/firewall dependency. Layered over appsettings.json the same way the
  // pradeep-* files are, just for local work.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Engine": {
    // Locally act as the WRITER so this instance creates the table and captures history into the
    // local DB. Without a writer, the local table would never be created or filled and the chart
    // would always be empty. (On the deployed instances only pradeep-2 is the writer.)
    "SpreadHistoryWriter": true
  },
  "Storage": {
    // Local SQL Server connection for spread history. Default below is LocalDB - it needs no
    // separate install and the app auto-creates the database + table on startup. If you run a full
    // local SQL Server instance instead, swap this for something like:
    //   "Server=localhost;Database=SpreadTraderHistory;Trusted_Connection=True;TrustServerCertificate=True;"
    // (add ;User ID=...;Password=... instead of Trusted_Connection if you use SQL auth locally).
    "SpreadHistoryConnectionString": "Server=(localdb)\\MSSQLLocalDB;Database=SpreadTraderHistory;Trusted_Connection=True;TrustServerCertificate=True;"
  }
}
