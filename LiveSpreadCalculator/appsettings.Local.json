{
  // Local development overlay - selected by ASPNETCORE_ENVIRONMENT=Local (see the "Local (Postgres)"
  // launch profile in Properties/launchSettings.json). Overrides the base appsettings.json - which
  // points spread history at the shared/production Postgres - so LOCAL runs use a local Postgres
  // instead, with no shared-DB or network dependency. Layered over appsettings.json the same way the
  // pradeep-* files are, just for local work.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      // .NET's IHttpClientFactory logs FOUR Information lines for every single outbound request
      // ("Start processing", "Sending", "Received response headers", "End processing"), across
      // every broker call, the instrument-master download and every Telegram send. That is pure
      // framework noise that buried the feed, order and trigger lines this app actually emits -
      // exactly what made a stalled market feed so hard to spot. Warning keeps genuine failures
      // (which log above Information) while dropping the per-request chatter.
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "Engine": {
    // Locally act as the WRITER so this instance creates the table and captures history into the
    // local DB. Without a writer, the local table would never be created or filled and the chart
    // would always be empty. (On the deployed instances only pradeep-2 is the writer.)
    "SpreadHistoryWriter": true
  },
  "Storage": {
    // Local Postgres connection for spread history. Matches `docker compose up db` (see
    // docker-compose.yml) with its default dev credentials - nothing sensitive, this database only
    // ever exists on a developer's own machine. If you run Postgres some other way locally, swap
    // Host/Port/Username/Password to match.
    "SpreadHistoryConnectionString": "Host=localhost;Port=5432;Database=spreadtrader_history;Username=postgres;Password=postgres"
  }
}
