<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>f9ebb550-15c1-429a-b17c-088c74a666f5</UserSecretsId>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <!-- This app is a handful of low-concurrency background timers (spread recalculation every
         ~250-300ms across the live universe, ranking every few minutes), not a high-throughput
         web server - it doesn't need Server GC's per-core heaps, which favor throughput by
         deliberately retaining committed memory and returning it to the OS only reluctantly.
         Under Server GC (the ASP.NET Core default), the frequent small allocations from every
         recalculation cycle make Task Manager's working set climb for a long time before it
         plateaus, which reads as a leak even when it isn't one. Workstation GC (with
         background/concurrent collection still on) collects more eagerly and gives memory back
         to the OS sooner, which better matches this workload. -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.11" />
    <PackageReference Include="EFCore.BulkExtensions" Version="8.1.2" />
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.22.1" />
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="8.0.11" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpreadTrader.Core\SpreadTrader.Core.csproj" />
    <ProjectReference Include="..\SpreadTrader.KiteIntegration\SpreadTrader.KiteIntegration.csproj" />
    <ProjectReference Include="..\SpreadTrader.DhanIntegration\SpreadTrader.DhanIntegration.csproj" />
    <ProjectReference Include="..\SpreadTrader.KotakIntegration\SpreadTrader.KotakIntegration.csproj" />
    <ProjectReference Include="..\SpreadTrader.Engine\SpreadTrader.Engine.csproj" />
  </ItemGroup>

  <!-- App_Data (users.csv, triggers.csv, etc.) defaults to a plain "None" item under the SDK's
       implicit globs, which dotnet publish does NOT copy anywhere. Without this, App_Data never
       makes it into publish output or the deploy.zip, even though the file exists in source - see
       CsvUserStore/CsvTriggerRuleStore, which both read from this folder at the deployed content
       root. Contains real (if placeholder) credentials, so keep it out of source control - see
       .gitignore. -->
  <ItemGroup>
    <Content Include="App_Data\**" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- 2026-07-15: Microsoft.NET.Sdk.Web has a built-in, unrestricted, recursive rule that copies
       every appsettings*.json file it finds ANYWHERE under the project directory into the publish
       output - it does NOT skip a folder just because it looks like previous build output (unlike
       bin/obj, which the SDK excludes by default). deploy*.ps1 used to run `dotnet publish -o
       ./publish` - a folder INSIDE this project directory - so once that folder existed and
       contained its own appsettings.Development.json (copied there on the very first run, as
       intended), every SUBSEQUENT run's appsettings glob matched that nested copy too and
       recreated it one level deeper inside the new output: publish\publish\, then
       publish\publish\publish\, and so on, forever, completely silently, until it exceeded
       Windows' 260-character path limit and Kudu's zip deploy started failing outright with
       PathTooLongException. The deploy scripts now publish OUTSIDE this project directory
       entirely (see $PublishDir in deploy.ps1/deploy-pradeep-1.ps1/deploy-pradeep-2.ps1), but that
       alone wasn't sufficient - a leftover, already-corrupted "publish" folder sitting inside this
       project directory from before that fix was STILL being scanned as a source of
       appsettings*.json files and reproduced the exact same nesting inside the new output on the
       very next run. This exclusion is the actual fix: it tells MSBuild to never treat anything
       under a "publish" folder anywhere in this project as a source item, regardless of how deep
       or corrupted it is or ever becomes again - so this class of bug can't resurface even if a
       stray "publish" folder reappears here by accident (e.g. someone runs a bare `dotnet publish`
       with no -o from this directory). -->
  <ItemGroup>
    <Content Remove="publish\**" />
    <None Remove="publish\**" />
    <Compile Remove="publish\**" />
    <EmbeddedResource Remove="publish\**" />
  </ItemGroup>

</Project>
