{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  // Which broker the engine trades through. "Kite" (Zerodha) or "Dhan" - see BrokerOptions.
  // Everything downstream (ticks, orders, margin, positions, instrument resolution, the login
  // flow) is resolved from this one setting at startup; no trading logic changes with it.
  // Override per-deployment with the Broker__Platform environment variable.
  //
  // AFTER SWITCHING: restart, then rebuild the universe once (POST /api/universe/build). The two
  // platforms use different tradingsymbols and different instrument ids, so spread definitions
  // resolved against one broker's instrument master cannot be reused against the other's.
  "Broker": {
    "Platform": "Dhan"
  },
  "Kite": {
    // Left blank deliberately - real values must never live in a committed file. Set them as
    // environment variables instead (Kite__ApiKey / Kite__ApiSecret / Kite__AccessToken), which
    // ASP.NET Core's config system layers over this file automatically. Locally, use
    // `dotnet user-secrets set Kite:ApiKey ...` (this project already has a UserSecretsId).
    // In Azure, set them as Application Settings on the Web App - see DEPLOYMENT.md.
    "ApiKey": "5fgc2092lgdlt550",
    "ApiSecret": "8invpehmpzffpotapmxvrf43ixlpn7gv",
    "AccessToken": "",
    "WsUrl": "wss://ws.kite.trade",
    "RestBaseUrl": "https://api.kite.trade",
    "TickerMode": "full"
  },
  // DhanHQ API v2. Only consulted when Broker:Platform is "Dhan" - see DhanOptions for the full
  // reference. Three ways to authenticate, chosen by AuthMode below:
  //   1. STATIC TOKEN (AuthMode "Static", the default): generate an access token in the Dhan web
  //      portal (Profile -> DhanHQ Trading APIs) and set ClientId + AccessToken. No browser login
  //      and no code runs on your behalf - Dhan currently fixes these at 24-hour validity, so this
  //      needs a fresh paste roughly once a day (the dashboard's "Enter Dhan token" button, or
  //      POST /api/auth/broker-token).
  //   2. TOTP (AuthMode "Totp"): set Pin + TotpSecret and leave AccessToken empty. The app mints
  //      and renews its own token with zero manual steps, ever - see README.md. Pin/TotpSecret are
  //      login CREDENTIALS, not tokens: unlike a leaked access token (self-limiting - expires
  //      within 24h regardless), together they let anyone mint a fresh token at will indefinitely.
  //   3. CONSENT FLOW (registered partner app): set AppId + AppSecret and leave AccessToken empty.
  //      The dashboard's login button then runs Dhan's browser consent handshake; those tokens
  //      last 24 hours. Independent of AuthMode - usable as a manual fallback on top of either
  //      mode above.
  // ClientId/AccessToken/Pin/TotpSecret/AppSecret are SECRETS - leave them blank here and supply
  // them as environment variables (Dhan__ClientId, Dhan__AccessToken, Dhan__Pin, Dhan__TotpSecret,
  // Dhan__AppSecret) or user-secrets, exactly as with the Kite credentials above.
  //
  // NOTE: Dhan requires the deployment's outbound IP to be whitelisted before order placement
  // works (data APIs work without it). Whitelist it under Dhan's API settings - the same
  // requirement zerodha-ip-whitelist.txt documents for Kite.
  "Dhan": {
    // "Static" (default - paste a token, currently valid ~24h) or "Totp" (fully automatic - the
    // app mints and renews its own token forever; see Pin/TotpSecret below and README.md).
    "AuthMode": "Totp",
    "ClientId": "1101635720",
    "AccessToken": "",
    // Totp mode only: your Dhan account PIN, and the base32 TOTP seed from Dhan Web -> Profile ->
    // DhanHQ Trading APIs -> Setup TOTP (the same string/QR an authenticator app would use).
    // SECRETS in the same sense as a password, not a rotating token - together they let whoever
    // holds them mint a fresh valid token at will, indefinitely. Never commit real values here.
    "Pin": "756989",
    "TotpSecret": "YSPSCYC2HSSIWBJYA5ZVV5P43GKZOXEM",
    "AppId": "",
    "AppSecret": "",
    "RestBaseUrl": "https://api.dhan.co/v2",
    "AuthBaseUrl": "https://auth.dhan.co",
    "WsUrl": "wss://api-feed.dhan.co",
    "OrderUpdateWsUrl": "wss://api-order-update.dhan.co",
    // Must be the COMPACT list. It is the only one of Dhan's two scrip masters with a
    // per-contract trading symbol column, and it carries tick and lot size just the same; the
    // detailed list has no usable trading symbol and loads zero instruments.
    "ScripMasterUrl": "https://images.dhan.co/api-data/api-scrip-master.csv",
    // "full" is required for spread triggers: it is the only Dhan feed mode carrying market depth
    // (best bid/ask), which is what spreads are evaluated against. "quote" and "ltp" do not.
    "TickerMode": "full",
    // Dhan's published Order API limit is 10 requests/sec; this leaves headroom under it. The
    // limit covers order reads too, and each placement is followed by up to four status polls.
    "OrdersPerSecond": 8,
    // Static mode only, to tell the dashboard when to stop offering its cached copy back. Dhan
    // currently issues portal tokens fixed at 24-hour validity. Totp/consent tokens ignore this
    // and use Dhan's own fixed 24-hour validity for those flows directly.
    "AccessTokenValidityDays": 1
  },
  "Engine": {
    "SpreadRecalculationIntervalMs": 150,
    "MinFireIntervalPerRuleMs": 2000,
    "RankingIntervalMinutes": 2,
    "VerifyMarginBeforeDispatch": true,
    "MarginSafetyBufferPercent": 5,
    "AutoSquareOffOnPartialFill": true,
    "RetryUnfilledLegOnPartialFill": true,
    "RetryUnfilledLegSlippageMultiplier": 3,
    "MarketProtectionPercent": 0.10,
    // Hourly spread-history capture (see SpreadHistoryCaptureHostedService). Snapshots every spread
    // at these IST times each trading day and bulk-inserts them into the history DB; the "Live
    // Spread" popup charts them. Default is the :29 mark of each trading hour 09:29-15:29. Add
    // "top of hour" entries (e.g. "10:00") if you want those too.
    // Only the single writer instance (pradeep-2) captures/writes/purges the shared history DB; all
    // other instances leave this false and only read it. Base default is false (read-only).
    "SpreadHistoryWriter": false,
    "SpreadHistoryCaptureEnabled": true,
    "SpreadHistorySnapshotTimesIst": [ "09:29", "10:29", "11:29", "12:29", "13:29", "14:29", "15:29" ],
    "SpreadHistoryWeekdaysOnly": true,
    "SpreadHistoryPurgeExpiredLegs": true,
    // Daily maintenance job (see DailyMaintenanceHostedService). Runs once a day at
    // DailyMaintenanceTimeIst (before the 09:15 open): wipes entry + exit triggers and the trigger
    // activity feed, and deletes spread-history rows older than SpreadHistoryRetentionDays.
    "DailyMaintenanceEnabled": true,
    "DailyMaintenanceTimeIst": "06:00",
    // Weekends off - the market is closed Sat/Sun, so no trigger/activity clear or history purge then.
    "DailyMaintenanceWeekdaysOnly": true,
    // Daily broker instrument master refresh (see InstrumentMasterRefreshHostedService) - same
    // 06:00 IST slot as daily maintenance above, ahead of the 09:15 open.
    "InstrumentMasterRefreshTimeIst": "06:00",
    "DailyMaintenanceClearTriggers": true,
    "DailyMaintenanceClearExitTriggers": true,
    "DailyMaintenanceClearTriggerActivity": true,
    "SpreadHistoryRetentionDays": 30
  },
  // MCX commodity arbitrage add-on. The ENTIRE feature is gated behind "Enabled": flip it to true
  // (or set Mcx__Enabled=true as an environment variable) and restart to switch it on. While it is
  // false, the app is byte-for-byte the NFO-only engine it always was: the instrument master only
  // downloads NFO, positions stay NFO-scoped, and margin checks use the equity segment. Nothing
  // else in this section is consulted until Enabled is true.
  "Mcx": {
    "Enabled": true,
    // Kite exchange + funds segment for commodities - leave as-is unless Kite renames them.
    "Exchange": "MCX",
    "MarginSegment": "commodity",
    // Two arbitrage styles, each independently switchable:
    //  - CalendarSpreads: near-expiry vs far-expiry of the same commodity (classic silver carry).
    //  - CrossContractSpreads: same-expiry SILVER vs SILVERM vs SILVERMIC etc. (per-kg spec gap).
    "CalendarSpreads": true,
    "CrossContractSpreads": true,
    // The big contract (SILVER 30kg) and its mini/micro siblings list different expiry cycles
    // (e.g. SILVER Sep/Dec vs SILVERM/SILVERMIC Aug/Nov), so cross-contract legs are matched on
    // their CLOSEST expiries rather than an identical month. A pair is skipped only if even the
    // nearest expiries are more than this many days apart (past that it's mostly calendar carry).
    "MaxCrossContractExpiryGapDays": 45,
    // Commodities to track (Kite instrument "name" values, not tradingsymbols). Trim/extend freely.
    "Underlyings": [
      "SILVER", "SILVERM", "SILVERMIC",
      "GOLD", "GOLDM",
      "CRUDEOIL", "CRUDEOILM",
      "NATURALGAS"
    ],
    // Same-commodity spec groups paired against each other when CrossContractSpreads is on. NOTE:
    // lot sizes differ across specs (SILVER 30kg / SILVERM 5kg / SILVERMIC 1kg), so balance trigger
    // quantities for kg-neutral exposure - a 1-lot-vs-1-lot basket is not hedged by kg.
    "CrossContractGroups": [
      { "Legs": [ "SILVER", "SILVERM", "SILVERMIC" ] },
      { "Legs": [ "GOLD", "GOLDM" ] },
      { "Legs": [ "CRUDEOIL", "CRUDEOILM" ] }
    ]
  },
  "Dashboard": {
    "BaseUrl": "https://localhost:63061"
  },
  "Storage": {
    "TriggersCsvPath": "App_Data/triggers.csv",
    "ExitTriggersCsvPath": "App_Data/exit_triggers.csv",
    "PnlAlertsCsvPath": "App_Data/pnl-alerts.csv",
    "FuturesCsvPath": "App_Data/futures_instruments.csv",
    // The raw Dhan scrip master, persisted exactly as downloaded so a restart can warm the
    // in-memory instrument index from disk instead of always re-downloading from Dhan first -
    // see DhanInstrumentMasterService.EnsureLoadedAsync. Unused on Kite.
    "DhanScripMasterCachePath": "App_Data/dhan_scrip_master_cache.csv",
    "UniverseCsvPath": "App_Data/universe_futures.csv",
    "McxUniverseCsvPath": "App_Data/universe_mcx.csv",
    "UsersCsvPath": "App_Data/users.csv",
    // EF Core connection string for the hourly spread history (see EfSpreadHistoryStore). Points at
    // the shared Azure SQL database (livespread-sql / SpreadTraderHistory) that pradeep-2 writes and
    // the other instances read. The table is auto-created on startup by the writer instance. NOTE:
    // the SQL password is committed here in plaintext; prefer overriding it via env var
    // Storage__SpreadHistoryConnectionString (double underscore) and rotating the password if shared.
    "SpreadHistoryConnectionString": "Server=tcp:livespread-sql.database.windows.net,1433;Initial Catalog=SpreadTraderHistory;Persist Security Info=False;User ID=spreadcal;Password=Ayush@123#;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=False;Connection Timeout=30;"
  },
  "Telegram": {
    // Order-execution notifications. When Enabled is true, every basket dispatch (all filled /
    // partial / rejected / margin-blocked) is posted to the ChatId below as an HTML message - see
    // TelegramOrderExecutionSink. BotToken is a secret: anyone with it can post as your bot, so in
    // any real deployment override it with an environment variable (Telegram__BotToken) or
    // `dotnet user-secrets set Telegram:BotToken "..."` rather than committing it here.
    "Enabled": true,
    "BotToken": "8673944185:AAHblJRtn3JhIbzBQ2mUqzj97FoSM5aqF4k",
    "ChatId": "-5232415388",
    "ApiBaseUrl": "https://api.telegram.org"
  },
  "Security": {
    // Secret key used to ENCRYPT the password column in App_Data/users.csv (reversible AES - see
    // PasswordProtector). This is what lets the app - and Tools/Decrypt-Users.ps1 - read the
    // original password back. Two hard rules:
    //   1. Override this with a real secret in production via env var Security__PasswordKey (double
    //      underscore) or `dotnet user-secrets set Security:PasswordKey "<32+ random chars>"`. The
    //      value below is a dev default only.
    //   2. Do NOT change it once passwords have been encrypted, or every stored enc: value becomes
    //      undecryptable. If you must rotate it, have each user set their password again afterward.
    // Leave blank to reuse Jwt:Key instead.
    "PasswordKey": "CHANGE_ME_pwd_dev_only_7c1e9a4b2f60d835e9a1c47b0f2d68a3"
  },
  "Jwt": {
    // App-login security. Every /api endpoint and the SignalR hub require a valid Bearer token
    // (see Program.cs) - only users listed in App_Data/users.csv can obtain one via
    // POST /api/auth/token. The external world can't consume the API without a token.
    //
    // Key MUST be overridden with a real secret in production - anyone who knows it can forge
    // tokens. Set it as an environment variable Jwt__Key (double underscore) or via
    // `dotnet user-secrets set Jwt:Key "<64+ random chars>"`. The value below is a dev default
    // only. Minimum 32 chars (256-bit) for HMAC-SHA256.
    "Key": "CHANGE_ME_dev_only_2f8b0c5a9e14d7360bd4a1f6c8e239105a7bce4d0f1928",
    "Issuer": "LiveSpreadCalculator",
    "Audience": "LiveSpreadCalculator.Dashboard",
    "ExpiryDays": 14
  }
}
