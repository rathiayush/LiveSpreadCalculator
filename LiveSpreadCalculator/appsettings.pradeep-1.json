{
  // Config for the independent "pradeep-1" instance - a separate Azure Web App (its own file
  // system, its own App_Data/*.csv, its own process) from Production, selected by setting
  // ASPNETCORE_ENVIRONMENT=pradeep-1 on that Web App (see deploy-pradeep-1.ps1, which sets this
  // automatically before deploying). ASP.NET Core's config system loads this file layered over
  // the base appsettings.json exactly the same way it loads appsettings.Production.json - the
  // environment name isn't restricted to Development/Staging/Production, any string works.
  //
  // Kite, Telegram, and Users have all been given their own distinct values for this instance
  // (own Kite Connect app/ApiKey, own Telegram bot/chat, own App_Data/users.pradeep-1.csv login
  // file - see Storage.UsersCsvPath below) - no longer copied from Production. Jwt.Key is still
  // the shared dev placeholder both files started with (see the Jwt section below) - lower
  // priority since it only affects login-token forgery, not trading, but still worth its own real
  // secret before this instance is treated as fully independent from Production.
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Kite": {
    // Left blank deliberately - real values must never live in a committed file. Set them as
    // environment variables instead (Kite__ApiKey / Kite__ApiSecret / Kite__AccessToken), which
    // ASP.NET Core's config system layers over this file automatically. Locally, use
    // `dotnet user-secrets set Kite:ApiKey ...` (this project already has a UserSecretsId).
    // In Azure, set them as Application Settings on the Web App - see DEPLOYMENT.md.
    "ApiKey": "uvodfm2h9gpwflyb",
    "ApiSecret": "510ciixmsp3e64b85rit4t5ln9jng1eo",
    "AccessToken": "",
    "WsUrl": "wss://ws.kite.trade",
    "RestBaseUrl": "https://api.kite.trade",
    "TickerMode": "full"
  },
  "Engine": {
    "SpreadRecalculationIntervalMs": 150,
    "MinFireIntervalPerRuleMs": 2000,
    "RankingIntervalMinutes": 2,
    "VerifyMarginBeforeDispatch": true,
    "MarginSafetyBufferPercent": 5,
    "AutoSquareOffOnPartialFill": true,
    "MarketProtectionPercent": 0.10
  },
  "Dashboard": {
    // This instance's own URL, not Production's - used only as the Kite OAuth redirect target
    // (see AuthController.Callback) so a login on this instance lands back on this instance's
    // own frontend. Real hostname for the "P1-LiveSpreadCalculator" Azure Web App.
    "BaseUrl": "https://p1-livespreadcalculator-bggucycqavegaset.southindia-01.azurewebsites.net"
  },
  "Storage": {
    "TriggersCsvPath": "App_Data/triggers.csv",
    "FuturesCsvPath": "App_Data/futures_instruments.csv",
    "UniverseCsvPath": "App_Data/universe_futures.csv",
    // Points directly at pradeep-1's own login file (not the shared App_Data/users.csv) so the
    // right accounts are read no matter how this app gets published - correct even if someone
    // deploys outside deploy-pradeep-1.ps1 (Visual Studio publish, manual upload, etc.) instead
    // of relying on that script to swap the file at package time.
    "UsersCsvPath": "App_Data/users.pradeep-1.csv"
  },
  "Telegram": {
    // Order-execution notifications. When Enabled is true, every basket dispatch (all filled /
    // partial / rejected / margin-blocked) is posted to the ChatId below as an HTML message - see
    // TelegramOrderExecutionSink. BotToken is a secret: anyone with it can post as your bot, so in
    // any real deployment override it with an environment variable (Telegram__BotToken) or
    // `dotnet user-secrets set Telegram:BotToken "..."` rather than committing it here.
    //
    // pradeep-1's own bot/chat - separate from Production's, so its order-execution messages land
    // in their own chat instead of mixing in with Production's.
    "Enabled": true,
    "BotToken": "8548297728:AAExiWgbakBJ73QbYBRZ0sBB505TGIMFU1s",
    "ChatId": "-5443854736",
    "ApiBaseUrl": "https://api.telegram.org"
  },
  "Jwt": {
    // App-login security. Every /api endpoint and the SignalR hub require a valid Bearer token
    // (see Program.cs) - only users listed in App_Data/users.csv can obtain one via
    // POST /api/auth/token. The external world can't consume the API without a token.
    //
    // Key MUST be overridden with a real secret in production - anyone who knows it can forge
    // tokens. Set it as an environment variable Jwt__Key (double underscore) or via
    // `dotnet user-secrets set Jwt:Key "<64+ random chars>"`. The value below is a dev default
    // only. Minimum 32 chars (256-bit) for HMAC-SHA256.
    "Key": "CHANGE_ME_dev_only_2f8b0c5a9e14d7360bd4a1f6c8e239105a7bce4d0f1928",
    "Issuer": "LiveSpreadCalculator",
    "Audience": "LiveSpreadCalculator.Dashboard",
    "ExpiryDays": 3
  }
}
