<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>SpreadTrader.Engine</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SpreadTrader.Core\SpreadTrader.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="8.0.2" />
  </ItemGroup>

  <ItemGroup>
    <!-- Lets SpreadTrader.Engine.Tests exercise the pure partial-fill/retry decision helpers on
         OrderDispatchHostedService directly, without having to make them part of the public API. -->
    <InternalsVisibleTo Include="SpreadTrader.Engine.Tests" />
  </ItemGroup>

</Project>
