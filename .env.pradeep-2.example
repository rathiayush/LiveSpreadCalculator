# Local override for running docker-compose.yml's api (which serves the UI itself - see that
# file's comments) AS the pradeep-2 instance.
#
# Usage:  docker compose --env-file .env.pradeep-2 -p spreadtrader-pradeep-2 up --build
# Then open http://localhost:8100 - the dashboard, API, and SignalR hub are all on that one port.
#
# See .env.production.example for the full explanation of the -p flag and why this file exists.
# Copy this to `.env.pradeep-2` (gitignored) and fill in real values before use - NEVER commit the
# filled-in file.
#
# NOTE: pradeep-2 is the SOLE WRITER of the shared spread-history database
# (Engine:SpreadHistoryWriter=true - see appsettings.pradeep-2.json) - running this instance locally
# against the SAME Postgres your deployed pradeep-2 writes to would have both writing/purging
# concurrently. Point POSTGRES_* below at a separate local `db` (the default - this compose stack's
# own container, not anything remote) unless you specifically intend to touch shared production
# data.

ASPNETCORE_ENVIRONMENT=pradeep-2

API_PORT=8100

# pradeep-2's own broker credentials (Broker:Platform is "Kite" for this instance - see
# appsettings.pradeep-2.json, unlike Production/pradeep-1 which use Dhan). A DIFFERENT account from
# Production and pradeep-1 - never reuse another instance's key here.
KITE_API_KEY=
KITE_API_SECRET=
# Never set a standing access token here - obtained daily via the dashboard's "Login to Kite".
KITE_ACCESS_TOKEN=

DASHBOARD_BASE_URL=http://localhost:8100

# This stack's OWN local Postgres (see the NOTE above on why not to point this at shared prod data).
POSTGRES_DB=spreadtrader_history
POSTGRES_USER=spreadtrader
POSTGRES_PASSWORD=
