# Local override for running docker-compose.yml's api (which serves the UI itself - see that
# file's comments) AS the pradeep-2 instance.
#
# Usage:  docker compose --env-file .env.pradeep-2 -p spreadtrader-pradeep-2 up --build
# Then open http://localhost:8100 - the dashboard, API, and SignalR hub are all on that one port.
#
# THIS IS ALSO THE TEMPLATE FOR DOKPLOY: everything below (minus the local-only API_PORT/POSTGRES_*
# lines) is exactly what to paste into pradeep-2's Dokploy Application -> Environment tab in one
# shot - see .env.production.example for the full explanation of this pattern.
#
# Copy this to `.env.pradeep-2` (gitignored) and fill in real values before use - NEVER commit the
# filled-in file, and never paste real values into a chat with an AI assistant, including this one.
#
# NOTE: pradeep-2 is the SOLE WRITER of the shared spread-history database
# (Engine:SpreadHistoryWriter=true - see appsettings.pradeep-2.json) - running this instance locally
# against the SAME Postgres your deployed pradeep-2 writes to would have both writing/purging
# concurrently. Point Storage__SpreadHistoryConnectionString/POSTGRES_* below at a separate local
# `db` (the default - this compose stack's own container, not anything remote) unless you
# specifically intend to touch shared production data.

ASPNETCORE_ENVIRONMENT=pradeep-2
ASPNETCORE_URLS=http://+:8080

API_PORT=8100

# ---- Broker: this instance uses Kite (Broker:Platform="Kite" in appsettings.pradeep-2.json,
# unlike Production/pradeep-1 which use Dhan) - a DIFFERENT Kite account from any other deployment,
# never reuse another key here.
Kite__ApiKey=
Kite__ApiSecret=
# Never set a standing access token here - it's a single-day token, obtained daily via the
# dashboard's "Login to Kite" button, not a config value with a long lifetime.
Kite__AccessToken=

Dashboard__BaseUrl=http://localhost:8100

# ---- Auth / password encryption - see the WARNING in LINUX_VPS_DEPLOYMENT.md §5 -----------------
# Currently a SHARED "CHANGE_ME_dev_only..." placeholder across all three instances in git -
# generate a real, random 32+ character value here, ideally DIFFERENT from Production/pradeep-1's.
#   Jwt__Key               signs every auth token for this instance's API/dashboard login
#   Security__PasswordKey  encrypts App_Data/users.pradeep-2.csv - do NOT change this again once
#                          set and in use, see Tools/Decrypt-Users.ps1
Jwt__Key=
Security__PasswordKey=

# ---- Telegram order/PNL alerts (optional - Telegram:Enabled in appsettings.pradeep-2.json) ------
# Also currently committed in git as a real, live bot token - rotate via @BotFather if cleaning up.
Telegram__BotToken=
Telegram__ChatId=

# pradeep-2 is the WRITER - this MUST be reachable and correct, or the shared history table (which
# Production and pradeep-1 both read from) stops getting new snapshots for everyone, not just this
# instance.
Storage__SpreadHistoryConnectionString=Host=db;Port=5432;Database=spreadtrader_history;Username=spreadtrader;Password=CHANGE_ME

# App_Data persistence - THIS INSTANCE'S OWN volume, never shared with Production/pradeep-1's.
Storage__TriggersCsvPath=/data/triggers.csv
Storage__ExitTriggersCsvPath=/data/exit_triggers.csv
Storage__PnlAlertsCsvPath=/data/pnl-alerts.csv
Storage__FuturesCsvPath=/data/futures_instruments.csv
Storage__BrokerPlatformOverridePath=/data/broker-platform-override.txt
Storage__UniverseCsvPath=/data/universe_futures.csv
Storage__McxUniverseCsvPath=/data/universe_mcx.csv
Storage__UsersCsvPath=/data/users.csv
# Storage__DhanScripMasterCachePath deliberately omitted - Dhan's raw scrip-master cache, unused
# on Kite (see Program.cs's comment on that path). Add it if you ever flip this instance's
# Broker:Platform to Dhan.

# ---- Local Postgres only (not part of the Dokploy paste - THIS STACK'S OWN local db, not shared
# production data, see the NOTE above) ------------------------------------------------------------
POSTGRES_DB=spreadtrader_history
POSTGRES_USER=spreadtrader
POSTGRES_PASSWORD=
